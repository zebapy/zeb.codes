---
import { site } from '@/data/site.ts';

const navItems = [
  { label: 'Home', href: '/', index: '01' },
  { label: 'Blog', href: '/blog', index: '02' },
  { label: 'Projects', href: '/projects', index: '03' },
  { label: 'Work', href: '/work', index: '04' },
];

const currentPath = Astro.url.pathname;

const isActive = (href: string) =>
  currentPath === href || (href !== '/' && currentPath.startsWith(href));

// Compact initials mark for the logo, e.g. "Zebhdiyah Pykosz" -> "ZP"
const initials = site.name
  .split(' ')
  .map((part) => part[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<header
  class="sticky top-0 z-50 border-b border-current-line/40 bg-base/70 backdrop-blur-xl supports-[backdrop-filter]:bg-base/55"
>
  <nav class="container">
    <div class="flex items-center justify-between py-4">
      <a
        href="/"
        class="group flex items-center gap-3 no-underline"
        aria-label={`${site.name} — home`}
      >
        <span
          class="grid h-9 w-9 place-items-center rounded-lg border border-purple/40 bg-purple/10 font-mono text-sm font-semibold text-purple transition-colors group-hover:border-purple group-hover:bg-purple/20"
        >
          {initials}
        </span>
        <span class="font-display text-lg font-semibold tracking-tight text-foreground transition-colors group-hover:text-purple">
          zeb<span class="text-purple">.</span>codes
        </span>
      </a>

      <button
        class="md:hidden p-2 z-50"
        aria-label="Toggle navigation"
        aria-expanded="false"
        id="mobile-toggle"
      >
        <span class="hamburger block w-6 h-0.5 bg-foreground relative transition-colors">
          <span class="absolute w-6 h-0.5 bg-foreground -translate-y-2 transition-transform"></span>
          <span class="absolute w-6 h-0.5 bg-foreground translate-y-2 transition-transform"></span>
        </span>
      </button>

      <ul class="hidden md:flex items-center gap-1 list-none m-0 p-0" id="nav-links">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'group flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-medium no-underline transition-colors',
                  isActive(item.href)
                    ? 'text-purple'
                    : 'text-comment hover:text-foreground',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                <span
                  class:list={[
                    'font-mono text-xs transition-colors',
                    isActive(item.href) ? 'text-purple/70' : 'text-current-line group-hover:text-comment',
                  ]}
                >
                  {item.index}
                </span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<style>
  @media (max-width: 768px) {
    #nav-links {
      @apply flex fixed top-0 right-0 bottom-0 w-72 bg-base border-l border-current-line/60 flex-col p-16 gap-2 translate-x-full transition-transform duration-300 ease-out;
    }

    #nav-links.open {
      @apply translate-x-0;
    }

    #mobile-toggle[aria-expanded='true'] .hamburger {
      @apply bg-transparent;
    }

    #mobile-toggle[aria-expanded='true'] .hamburger span:first-child {
      @apply rotate-45 translate-y-0;
    }

    #mobile-toggle[aria-expanded='true'] .hamburger span:last-child {
      @apply -rotate-45 translate-y-0;
    }
  }
</style>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const navLinks = document.getElementById('nav-links');

  toggle?.addEventListener('click', () => {
    const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isExpanded));
    navLinks?.classList.toggle('open');
  });

  navLinks?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      navLinks?.classList.remove('open');
    });
  });
</script>
