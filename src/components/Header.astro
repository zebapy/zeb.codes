---
import { site } from '@/data/site.ts';

const navItems = [
  { label: 'work', href: '/work' },
  { label: 'projects', href: '/projects' },
  { label: 'blog', href: '/blog' },
];

const currentPath = Astro.url.pathname;

const isActive = (href: string) =>
  currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<header
  class="sticky top-0 z-50 border-b border-current-line/50 bg-base/80 backdrop-blur-xl supports-[backdrop-filter]:bg-base/60"
>
  <nav class="container" aria-label="Primary">
    <div class="flex items-center justify-between py-4">
      <a
        href="/"
        class="group flex min-h-11 items-center no-underline"
        aria-label={`${site.name} — home`}
      >
        <span
          class="font-display text-sm font-extrabold tracking-tight text-foreground transition-colors group-hover:text-purple"
        >
          zeb<span class="text-purple">.</span>codes
        </span>
      </a>

      <button
        class="z-50 grid min-h-11 min-w-11 place-items-center md:hidden"
        aria-label="Toggle navigation"
        aria-expanded="false"
        id="mobile-toggle"
      >
        <span class="hamburger relative block h-0.5 w-5 bg-foreground transition-colors">
          <span class="absolute left-0 top-0 h-0.5 w-5 -translate-y-1.5 bg-foreground transition-transform"></span>
          <span class="absolute left-0 top-0 h-0.5 w-5 translate-y-1.5 bg-foreground transition-transform"></span>
        </span>
      </button>

      <ul class="m-0 hidden list-none items-center gap-8 p-0 md:flex" id="nav-links">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'inline-flex min-h-11 items-center font-mono text-sm no-underline transition-colors',
                  isActive(item.href) ? 'text-purple' : 'text-comment hover:text-foreground',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={`mailto:${site.email}`}
            class="inline-flex min-h-11 items-center font-mono text-sm text-comment no-underline hover:text-purple"
          >
            {site.email}
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<style>
  @media (max-width: 768px) {
    #nav-links {
      @apply fixed bottom-0 right-0 top-0 flex w-72 translate-x-full flex-col gap-1 border-l border-current-line/60 bg-base p-16 transition-transform duration-300 ease-out;
    }

    #nav-links.open {
      @apply translate-x-0;
    }

    #mobile-toggle[aria-expanded='true'] .hamburger {
      @apply bg-transparent;
    }

    #mobile-toggle[aria-expanded='true'] .hamburger span:first-child {
      @apply translate-y-0 rotate-45;
    }

    #mobile-toggle[aria-expanded='true'] .hamburger span:last-child {
      @apply translate-y-0 -rotate-45;
    }
  }
</style>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const navLinks = document.getElementById('nav-links');

  toggle?.addEventListener('click', () => {
    const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isExpanded));
    navLinks?.classList.toggle('open');
  });

  navLinks?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      navLinks?.classList.remove('open');
    });
  });
</script>
