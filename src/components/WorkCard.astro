---
import TagList from './TagList.astro';
import FormattedDate from './FormattedDate.astro';

interface Props {
  title: string;
  description: string;
  client?: string;
  tags: string[];
  image?: string;
  slug: string;
  startDate: Date;
  endDate?: Date;
}

const { title, description, client, tags, image, slug, startDate, endDate } = Astro.props;
---

<article class="bg-current-line rounded overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl h-full flex flex-col">
  <a href={`/work/${slug}`} class="flex flex-col h-full no-underline">
    {image && (
      <div class="aspect-video overflow-hidden">
        <img src={image} alt={title} class="w-full h-full object-cover transition-transform duration-300 hover:scale-105" />
      </div>
    )}
    <div class="p-8 flex-1 flex flex-col">
      <h3 class="text-xl font-bold mb-1 text-foreground">{title}</h3>
      {client && <p class="text-sm text-purple font-semibold mb-1">{client}</p>}
      <p class="text-sm text-comment mb-4">
        <FormattedDate date={startDate} />
        {endDate ? (
          <>
            {' '}&mdash; <FormattedDate date={endDate} />
          </>
        ) : (
          <> &mdash; Present</>
        )}
      </p>
      <p class="text-foreground mb-4 flex-1">{description}</p>
      <TagList tags={tags} />
    </div>
  </a>
</article>
