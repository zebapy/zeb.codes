---
import TagList from './TagList.astro';
import FormattedDate from './FormattedDate.astro';

interface Props {
  title: string;
  description: string;
  client?: string;
  tags: string[];
  image?: string;
  slug: string;
  startDate: Date;
  endDate?: Date;
}

const { title, description, client, tags, image, slug, startDate, endDate } = Astro.props;
---

<article class="card group h-full">
  <a href={`/work/${slug}`} class="flex h-full flex-col no-underline">
    {image && (
      <div class="aspect-video overflow-hidden">
        <img
          src={image}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
        />
      </div>
    )}
    <div class="flex flex-1 flex-col p-6">
      {client && <p class="kicker mb-2 text-purple/80">{client}</p>}
      <h3 class="mb-2 text-xl font-display font-semibold leading-snug text-foreground transition-colors group-hover:text-purple">
        {title}
      </h3>
      <p class="mb-4 font-mono text-xs text-comment">
        <FormattedDate date={startDate} />
        {endDate ? (
          <>
            {' '}&mdash; <FormattedDate date={endDate} />
          </>
        ) : (
          <> &mdash; Present</>
        )}
      </p>
      <p class="mb-5 flex-1 text-sm leading-relaxed text-comment">{description}</p>
      <TagList tags={tags} />
    </div>
  </a>
</article>
