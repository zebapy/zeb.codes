---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags && tags.length > 0 && (
    <ul class="flex flex-wrap gap-1.5 list-none p-0 m-0">
      {tags.map((tag) => (
        <li class="rounded-md border border-current-line/60 bg-base/40 px-2 py-0.5 font-mono text-xs text-comment transition-colors group-hover:border-purple/30 group-hover:text-purple">
          {tag}
        </li>
      ))}
    </ul>
  )
}
