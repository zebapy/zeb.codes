---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags && tags.length > 0 && (
    <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
      {tags.map((tag) => (
        <li class="text-sm px-2 py-1 bg-current-line text-purple rounded font-mono">{tag}</li>
      ))}
    </ul>
  )
}
