---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags && tags.length > 0 && (
    <ul class="flex flex-wrap gap-1.5 list-none p-0 m-0">
      {tags.map((tag) => (
        <li class="border border-current-line/60 px-2 py-0.5 font-mono text-xs text-comment">
          {tag}
        </li>
      ))}
    </ul>
  )
}
