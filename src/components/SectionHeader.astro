---
interface Props {
  index?: string;
  kicker?: string;
  title: string;
  href?: string;
  linkLabel?: string;
}

const { index, kicker, title, href, linkLabel = 'View all' } = Astro.props;
---

<div class="mb-8 flex items-end justify-between gap-4 border-b border-current-line/40 pb-4">
  <div>
    <p class="kicker mb-2 flex items-center gap-2">
      {index && <span class="section-index">{index}</span>}
      {kicker}
    </p>
    <h2 class="mb-0 lowercase">{title}</h2>
  </div>

  {
    href && (
      <a
        href={href}
        class="link-underline group hidden shrink-0 items-center gap-2 font-mono text-sm text-cyan hover:text-pink sm:flex"
      >
        {linkLabel}
        <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
      </a>
    )
  }
</div>
