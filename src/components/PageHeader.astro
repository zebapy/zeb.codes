---
interface Props {
  kicker?: string;
  title: string;
  description?: string;
}

const { kicker, title, description } = Astro.props;
---

<header class="border-b border-current-line/50 pb-10 pt-16 md:pt-20">
  {kicker && <p class="kicker mb-5">{kicker}</p>}
  <h1 class="mb-0 text-4xl tracking-tighter md:text-5xl">{title}</h1>
  {
    description && (
      <p class="mb-0 mt-5 max-w-2xl text-lg leading-relaxed text-comment">{description}</p>
    )
  }
</header>
