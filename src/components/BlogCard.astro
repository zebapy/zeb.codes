---
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  heroImage?: string;
  tags?: string[];
  slug: string;
}

const { title, description, pubDate, heroImage, tags, slug } = Astro.props;
---

<article class="bg-current-line rounded overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl">
  <a href={`/blog/${slug}`} class="block no-underline">
    {heroImage && (
      <div class="aspect-video overflow-hidden">
        <img src={heroImage} alt={title} class="w-full h-full object-cover transition-transform duration-300 hover:scale-105" />
      </div>
    )}
    <div class="p-8">
      <h3 class="text-xl font-bold mb-2 text-foreground">{title}</h3>
      <p class="text-sm text-comment mb-4">
        <FormattedDate date={pubDate} />
      </p>
      <p class="text-foreground mb-4">{description}</p>
      {tags && <TagList tags={tags} />}
    </div>
  </a>
</article>
