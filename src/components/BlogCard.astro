---
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  heroImage?: string;
  tags?: string[];
  slug: string;
}

const { title, description, pubDate, heroImage, tags, slug } = Astro.props;
---

<article class="card group h-full">
  <a href={`/blog/${slug}`} class="flex h-full flex-col no-underline">
    {heroImage && (
      <div class="aspect-video overflow-hidden">
        <img
          src={heroImage}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
        />
      </div>
    )}
    <div class="flex flex-1 flex-col p-6">
      <p class="kicker mb-3">
        <FormattedDate date={pubDate} />
      </p>
      <h3 class="mb-2 text-xl font-display font-semibold leading-snug text-foreground transition-colors group-hover:text-purple">
        {title}
      </h3>
      <p class="mb-5 flex-1 text-sm leading-relaxed text-comment">{description}</p>
      {tags && <TagList tags={tags} />}
    </div>
  </a>
</article>
