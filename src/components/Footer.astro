---
import { site } from '@/data/site.ts';

const currentYear = new Date().getFullYear();
---

<footer class="bg-background border-t border-current-line mt-16 py-16">
  <div class="container">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-8 md:gap-4">
      <div class="footer-info">
        <p class="mb-2 text-sm text-comment">&copy; {currentYear} {site.name}. All rights reserved.</p>
        <p class="mb-0 text-sm text-comment">
          <a href={`mailto:${site.email}`} class="text-cyan hover:text-purple">{site.email}</a>
        </p>
      </div>

      <div class="flex gap-4 flex-wrap">
        {
          site.social.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.name}
              class="text-comment text-sm hover:text-purple transition-colors"
            >
              {link.name}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
