---
import { site } from '@/data/site.ts';

const currentYear = new Date().getFullYear();
---

<footer class="mt-24 border-t border-current-line/40">
  <div class="container py-16">
    <!-- Oversized editorial call-to-action -->
    <div class="mb-16 border-b border-current-line/30 pb-16">
      <p class="kicker mb-4">Get in touch</p>
      <a
        href={`mailto:${site.email}`}
        class="link-underline font-display text-3xl font-bold tracking-tight text-foreground hover:text-purple sm:text-4xl"
      >
        {site.email}
      </a>
    </div>

    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <p class="mb-0 font-mono text-xs text-comment">
        &copy; {currentYear} {site.name} &mdash; built with Astro in Vermont.
      </p>

      <div class="flex flex-wrap gap-5">
        {
          site.social.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.name}
              class="link-underline font-mono text-xs uppercase tracking-widest text-comment hover:text-purple"
            >
              {link.name}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
