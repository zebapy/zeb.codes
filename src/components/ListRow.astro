---
interface Props {
  href: string;
  title: string;
  meta?: string;
  description?: string;
  index?: string;
}

const { href, title, meta, description, index } = Astro.props;
---

<li class="border-t border-current-line/50 last:border-b">
  <a href={href} class="group block py-5 no-underline">
    <div
      class:list={[
        'grid items-baseline gap-x-4',
        index ? 'grid-cols-[1.5rem_minmax(0,1fr)_auto]' : 'grid-cols-[minmax(0,1fr)_auto]',
      ]}
    >
      {
        index && (
          <span class="font-mono text-xs tabular-nums text-comment/60">{index}</span>
        )
      }

      <span class="flex min-w-0 items-baseline gap-4">
        <span
          class="font-display text-lg font-bold leading-snug tracking-tight text-foreground transition-colors group-hover:text-purple sm:text-xl"
        >
          {title}
        </span>
        <span class="leader hidden sm:block" aria-hidden="true"></span>
      </span>

      {
        meta && (
          <span class="shrink-0 font-mono text-xs tabular-nums text-comment transition-colors group-hover:text-purple">
            {meta}
          </span>
        )
      }

      {
        description && (
          <p
            class:list={[
              'col-end-[-1] mb-0 mt-1.5 max-w-2xl text-sm leading-relaxed text-comment',
              index ? 'col-start-2' : 'col-start-1',
            ]}
          >
            {description}
          </p>
        )
      }
    </div>
  </a>
</li>
