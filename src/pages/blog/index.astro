---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/BaseLayout.astro';
import BlogCard from '@/components/BlogCard.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Blog" description="Articles and thoughts on frontend development, design, and technology.">
  <div class="container">
    <header class="page-header">
      <h1>Blog</h1>
      <p>Articles and thoughts on frontend development, design, and technology.</p>
    </header>

    {
      sortedPosts.length === 0 ? (
        <p class="no-posts">No blog posts yet. Check back soon!</p>
      ) : (
        <div class="blog-list">
          {sortedPosts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              heroImage={post.data.heroImage}
              tags={post.data.tags}
              slug={post.slug}
            />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .page-header {
    padding: var(--spacing-xl) 0;
    border-bottom: var(--border-width) solid var(--color-border);
    margin-bottom: var(--spacing-xl);
  }

  .page-header h1 {
    margin-bottom: var(--spacing-sm);
  }

  .page-header p {
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
    margin-bottom: 0;
  }

  .blog-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
  }

  .no-posts {
    text-align: center;
    color: var(--color-text-muted);
    padding: var(--spacing-xl);
  }
</style>
