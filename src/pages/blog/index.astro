---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/BaseLayout.astro';
import CatalogHeading from '@/components/CatalogHeading.astro';
import ListRow from '@/components/ListRow.astro';
import PageHeader from '@/components/PageHeader.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const postDate = (date: Date) =>
  `${date.getFullYear()}·${String(date.getMonth() + 1).padStart(2, '0')}`;
---

<BaseLayout title="Blog" description="Articles and thoughts on frontend development, design, and technology.">
  <div class="container pb-16">
    <PageHeader
      kicker="Writing"
      title="Field notes"
      description="Articles and thoughts on frontend development, design, and technology."
    />

    {
      sortedPosts.length === 0 ? (
        <p class="py-16 text-comment">No posts yet. Check back soon.</p>
      ) : (
        <>
          <CatalogHeading label="Index" meta="Date" />
          <ul class="m-0 list-none p-0">
            {sortedPosts.map((post, i) => (
              <ListRow
                index={String(i + 1).padStart(2, '0')}
                href={`/blog/${post.id}`}
                title={post.data.title}
                description={post.data.description}
                meta={postDate(post.data.pubDate)}
              />
            ))}
          </ul>
        </>
      )
    }
  </div>
</BaseLayout>
