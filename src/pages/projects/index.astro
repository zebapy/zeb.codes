---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/BaseLayout.astro';
import CatalogHeading from '@/components/CatalogHeading.astro';
import ListRow from '@/components/ListRow.astro';
import PageHeader from '@/components/PageHeader.astro';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort(
  (a, b) => (b.data.order || 0) - (a.data.order || 0)
);

const yearOf = (date?: Date) => (date ? String(date.getFullYear()) : '—');
---

<BaseLayout
  title="Projects"
  description="Personal projects and experiments in frontend development and Node.js."
>
  <div class="container pb-16">
    <PageHeader
      kicker="Side quests"
      title="Projects"
      description="Personal projects and experiments in frontend development and Node.js."
    />

    {
      sortedProjects.length === 0 ? (
        <p class="py-16 text-comment">No projects yet. Check back soon.</p>
      ) : (
        <>
          <CatalogHeading label="Index" />
          <ul class="m-0 list-none p-0">
            {sortedProjects.map((project, i) => (
              <ListRow
                index={String(i + 1).padStart(2, '0')}
                href={`/projects/${project.id}`}
                title={project.data.title}
                description={project.data.description}
                meta={yearOf(project.data.endDate ?? project.data.startDate)}
              />
            ))}
          </ul>
        </>
      )
    }
  </div>
</BaseLayout>
