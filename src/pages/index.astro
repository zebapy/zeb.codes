---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/BaseLayout.astro';
import ListRow from '@/components/ListRow.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { site } from '@/data/site.ts';

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const formatRange = (start: Date, end?: Date) =>
  `${start.getFullYear()} – ${end ? end.getFullYear() : 'now'}`;

// Get recent blog posts (latest 3)
const allBlogPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allBlogPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Get featured work (up to 3)
const allWork = await getCollection('work');
const featuredWork = allWork
  .filter((item) => item.data.featured)
  .sort((a, b) => (b.data.order || 0) - (a.data.order || 0))
  .slice(0, 3);

// Get featured projects (up to 3)
const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((item) => item.data.featured)
  .sort((a, b) => (b.data.order || 0) - (a.data.order || 0))
  .slice(0, 3);
---

<BaseLayout>
  <div class="container">
    <!-- Hero -->
    <section class="relative py-20 md:py-28">
      <div class="grid gap-12 md:grid-cols-[1fr_auto] md:items-center">
        <div class="max-w-3xl">
          <p class="kicker reveal mb-6 flex items-center gap-3" style="animation-delay: 0ms">
            <span class="inline-block h-px w-8 bg-purple/60"></span>
            {site.name} · {site.role}
          </p>

          <h1 class="reveal mb-8 text-foreground" style="animation-delay: 80ms">
            Frontend developer with a penchant for
            <span class="text-purple">UI/UX design</span>, located in Middlebury, Vermont.
          </h1>

          <div class="reveal flex flex-wrap gap-3" style="animation-delay: 160ms">
            {
              site.social.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center gap-2 rounded-lg border border-current-line/60 bg-surface/60 px-4 py-2 font-mono text-sm text-foreground no-underline transition-colors hover:border-purple/60 hover:text-purple"
                >
                  {link.name}
                  <span class="text-comment transition-transform group-hover:translate-x-0.5 group-hover:text-purple">
                    &#8599;
                  </span>
                </a>
              ))
            }
          </div>
        </div>

        <div class="reveal relative mx-auto md:mx-0" style="animation-delay: 200ms">
          <div
            class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-56 w-56 -translate-x-1/2 -translate-y-1/2 rounded-full bg-purple/30 blur-3xl animate-glow-drift"
          >
          </div>
          <div class="relative">
            <span
              class="absolute -inset-3 rounded-xl border border-current-line/40"
              aria-hidden="true"></span>
            <img
              src={site.avatar}
              alt={site.pic_alt}
              class="relative h-44 w-44 rounded-lg object-cover shadow-2xl ring-1 ring-purple/40 md:h-52 md:w-52"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Recent Blog Posts -->
    {
      recentPosts.length > 0 && (
        <section class="mb-24">
          <SectionHeader index="01" kicker="Writing" title="Recent posts" href="/blog" />
          <ul class="list-none m-0 p-0">
            {recentPosts.map((post) => (
              <ListRow
                href={`/blog/${post.id}`}
                title={post.data.title}
                meta={formatDate(post.data.pubDate)}
                description={post.data.description}
              />
            ))}
          </ul>
        </section>
      )
    }

    <!-- Featured Work -->
    {
      featuredWork.length > 0 && (
        <section class="mb-24">
          <SectionHeader index="02" kicker="Experience" title="Featured work" href="/work" />
          <ul class="list-none m-0 p-0">
            {featuredWork.map((work) => (
              <ListRow
                href={`/work/${work.id}`}
                title={work.data.client ? `${work.data.title} · ${work.data.client}` : work.data.title}
                meta={formatRange(work.data.startDate, work.data.endDate)}
                description={work.data.description}
              />
            ))}
          </ul>
        </section>
      )
    }

    <!-- Featured Projects -->
    {
      featuredProjects.length > 0 && (
        <section class="mb-24">
          <SectionHeader index="03" kicker="Side quests" title="Featured projects" href="/projects" />
          <ul class="list-none m-0 p-0">
            {featuredProjects.map((project) => (
              <ListRow
                href={`/projects/${project.id}`}
                title={project.data.title}
                description={project.data.description}
              />
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
