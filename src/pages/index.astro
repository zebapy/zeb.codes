---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/BaseLayout.astro';
import CatalogHeading from '@/components/CatalogHeading.astro';
import ListRow from '@/components/ListRow.astro';
import { site } from '@/data/site.ts';

const yearOf = (date?: Date) => (date ? String(date.getFullYear()) : 'ongoing');

const postDate = (date: Date) =>
  `${date.getFullYear()}·${String(date.getMonth() + 1).padStart(2, '0')}`;

const allBlogPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allBlogPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const allWork = await getCollection('work');
const featuredWork = allWork
  .filter((item) => item.data.featured)
  .sort((a, b) => (b.data.order || 0) - (a.data.order || 0));

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((item) => item.data.featured)
  .sort((a, b) => (b.data.order || 0) - (a.data.order || 0));

const indexEntries = [
  ...featuredWork.map((w) => ({
    href: `/work/${w.id}`,
    title: w.data.client ? `${w.data.title} · ${w.data.client}` : w.data.title,
    meta: yearOf(w.data.endDate ?? w.data.startDate),
  })),
  ...featuredProjects.map((p) => ({
    href: `/projects/${p.id}`,
    title: p.data.title,
    meta: yearOf(p.data.endDate),
  })),
].slice(0, 6);

const skills = ['TypeScript', 'React', 'Astro', 'CSS', 'UI/UX', 'Node'];
---

<BaseLayout>
  <div class="container">
    <section
      class="grid items-end gap-10 border-b border-current-line/50 pb-14 pt-16 md:grid-cols-[1fr_auto] md:pt-24"
    >
      <div>
        <p class="kicker mb-6">{site.role} — Middlebury, Vermont</p>
        <h1 class="mb-0 text-5xl leading-[0.92] tracking-tighter md:text-7xl">
          Zebhdiyah<br />Pykosz<span class="text-purple">.</span>
        </h1>
        <p class="mt-8 mb-0 max-w-md text-comment">{site.summary}</p>
      </div>
      <div class="font-mono text-xs leading-[2.2] text-comment md:text-right">
        <div class="inline-flex items-center gap-2 text-purple md:justify-end">
          <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-purple opacity-40 motion-reduce:animate-none"
            ></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-purple"></span>
          </span>
          available for work
        </div>
        <div>{indexEntries.length} entries</div>
        <div>{recentPosts.length} field notes</div>
      </div>
    </section>

    {
      indexEntries.length > 0 && (
        <section class="border-b border-current-line/50 py-12">
          <CatalogHeading label="Index" />
          <ul class="m-0 list-none p-0">
            {indexEntries.map((entry, i) => (
              <ListRow
                index={String(i + 1).padStart(2, '0')}
                href={entry.href}
                title={entry.title}
                meta={entry.meta}
              />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section class="border-b border-current-line/50 py-12">
          <CatalogHeading label="Field notes" href="/blog" meta="Date" />
          <ul class="m-0 list-none p-0">
            {recentPosts.map((post) => (
              <ListRow
                href={`/blog/${post.id}`}
                title={post.data.title}
                meta={postDate(post.data.pubDate)}
              />
            ))}
          </ul>
        </section>
      )
    }

    <section class="grid gap-8 py-14 md:grid-cols-[200px_1fr]">
      <p class="kicker mb-0">About</p>
      <div>
        <p class="mb-0 max-w-2xl text-lg leading-relaxed text-foreground/90">
          I'm a frontend developer who cares a little too much about how things feel — chasing
          the line between fast and delightful across the surfaces people touch every day.
        </p>
        <ul class="mt-6 mb-0 flex list-none flex-wrap gap-2 p-0">
          {
            skills.map((skill) => (
              <li class="border border-current-line/70 px-3 py-1.5 font-mono text-xs text-comment">
                {skill}
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>
