---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/BaseLayout.astro';
import WorkCard from '@/components/WorkCard.astro';
import PageHeader from '@/components/PageHeader.astro';

const allWork = await getCollection('work');
const sortedWork = allWork.sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf()
);
---

<BaseLayout
  title="Work"
  description="Professional work and client projects in frontend development and full-stack applications."
>
  <div class="container">
    <PageHeader
      kicker="Experience"
      title="Work"
      description="Professional work and client projects in frontend development and full-stack applications."
    />

    {
      sortedWork.length === 0 ? (
        <p class="text-center text-comment py-16">No work entries yet. Check back soon!</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
          {sortedWork.map((work) => (
            <WorkCard
              title={work.data.title}
              description={work.data.description}
              client={work.data.client}
              tags={work.data.tags}
              image={work.data.image}
              slug={work.id}
              startDate={work.data.startDate}
              endDate={work.data.endDate}
            />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
