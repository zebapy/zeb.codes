---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/BaseLayout.astro';
import CatalogHeading from '@/components/CatalogHeading.astro';
import ListRow from '@/components/ListRow.astro';
import PageHeader from '@/components/PageHeader.astro';

const allWork = await getCollection('work');
const sortedWork = allWork.sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf()
);

const yearOf = (date?: Date) => (date ? String(date.getFullYear()) : 'now');
---

<BaseLayout
  title="Work"
  description="Professional work and client projects in frontend development and full-stack applications."
>
  <div class="container pb-16">
    <PageHeader
      kicker="Experience"
      title="Work"
      description="Professional work and client projects in frontend development and full-stack applications."
    />

    {
      sortedWork.length === 0 ? (
        <p class="py-16 text-comment">No work entries yet. Check back soon.</p>
      ) : (
        <>
          <CatalogHeading label="Index" />
          <ul class="m-0 list-none p-0">
            {sortedWork.map((work, i) => (
              <ListRow
                index={String(i + 1).padStart(2, '0')}
                href={`/work/${work.id}`}
                title={work.data.client ? `${work.data.title} · ${work.data.client}` : work.data.title}
                description={work.data.description}
                meta={`${yearOf(work.data.startDate)}–${yearOf(work.data.endDate)}`}
              />
            ))}
          </ul>
        </>
      )
    }
  </div>
</BaseLayout>
