---
import BaseLayout from '@/components/BaseLayout.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import TagList from '@/components/TagList.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
}

const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage}>
  <article class="container">
    <header class="py-16 border-b border-current-line mb-16">
      {heroImage && (
        <div class="mb-8 rounded overflow-hidden">
          <img src={heroImage} alt={title} class="w-full h-auto block" />
        </div>
      )}
      <h1 class="text-4xl md:text-5xl font-bold mb-4">{title}</h1>
      <div class="text-sm text-comment mb-4">
        <time datetime={pubDate.toISOString()}>
          <FormattedDate date={pubDate} />
        </time>
        {updatedDate && (
          <span class="ml-2 italic">
            (Updated: <FormattedDate date={updatedDate} />)
          </span>
        )}
      </div>
      {tags && <TagList tags={tags} />}
    </header>

    <div class="content mx-auto mb-16">
      <slot />
    </div>
  </article>
</BaseLayout>
