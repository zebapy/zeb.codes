---
import BaseLayout from '@/components/BaseLayout.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import TagList from '@/components/TagList.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
}

const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage}>
  <article class="container">
    <header class="content mx-auto pt-16 pb-12">
      <a
        href="/blog"
        class="link-underline mb-8 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-comment hover:text-purple"
      >
        &larr; All posts
      </a>
      <div class="mb-5 font-mono text-xs text-comment group">
        <time datetime={pubDate.toISOString()}>
          <FormattedDate date={pubDate} />
        </time>
        {updatedDate && (
          <span class="ml-2 italic">
            (Updated: <FormattedDate date={updatedDate} />)
          </span>
        )}
      </div>
      <h1 class="mb-6">{title}</h1>
      <p class="mb-6 text-lg leading-relaxed text-comment">{description}</p>
      {tags && <div class="group"><TagList tags={tags} /></div>}
    </header>

    {heroImage && (
      <div class="content mx-auto mb-12 overflow-hidden rounded-xl border border-current-line/50">
        <img src={heroImage} alt={title} class="block h-auto w-full" />
      </div>
    )}

    <div class="prose content mx-auto mb-16">
      <slot />
    </div>
  </article>
</BaseLayout>
