---
import BaseLayout from '@/components/BaseLayout.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import TagList from '@/components/TagList.astro';

interface Props {
  title: string;
  description: string;
  client?: string;
  tags: string[];
  tech: string[];
  image?: string;
  liveUrl?: string;
  caseStudyUrl?: string;
  startDate: Date;
  endDate?: Date;
}

const {
  title,
  description,
  client,
  tags,
  tech,
  image,
  liveUrl,
  caseStudyUrl,
  startDate,
  endDate,
} = Astro.props;
---

<BaseLayout title={title} description={description} image={image}>
  <article class="container">
    <header class="content mx-auto pb-12 pt-16">
      <a
        href="/work"
        class="link-underline mb-8 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-comment hover:text-purple"
      >
        &larr; Work
      </a>
      <p class="kicker mb-5">
        {client && <span>{client} · </span>}
        <FormattedDate date={startDate} />
        {
          endDate ? (
            <>
              {' '}
              &mdash; <FormattedDate date={endDate} />
            </>
          ) : (
            <> &mdash; Present</>
          )
        }
      </p>
      <h1 class="mb-6 tracking-tighter">{title}</h1>
      <p class="mb-8 text-lg leading-relaxed text-comment">{description}</p>

      <div class="grid gap-8 sm:grid-cols-2">
        {tags.length > 0 && (
          <div>
            <p class="kicker mb-3">Tags</p>
            <TagList tags={tags} />
          </div>
        )}
        {tech.length > 0 && (
          <div>
            <p class="kicker mb-3">Tech</p>
            <TagList tags={tech} />
          </div>
        )}
      </div>

      {(liveUrl || caseStudyUrl) && (
        <div class="mt-8 flex flex-wrap gap-6">
          {liveUrl && (
            <a
              href={liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="link-underline font-mono text-xs uppercase tracking-widest"
            >
              View live
            </a>
          )}
          {caseStudyUrl && (
            <a
              href={caseStudyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="link-underline font-mono text-xs uppercase tracking-widest"
            >
              Case study
            </a>
          )}
        </div>
      )}
    </header>

    {image && (
      <div class="content mx-auto mb-12 overflow-hidden border border-current-line/50">
        <img src={image} alt="" class="block h-auto w-full" />
      </div>
    )}

    <div class="prose content mx-auto mb-16">
      <slot />
    </div>
  </article>
</BaseLayout>
