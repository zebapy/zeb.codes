---
import BaseLayout from '@/components/BaseLayout.astro';
import TagList from '@/components/TagList.astro';
import FormattedDate from '@/components/FormattedDate.astro';

interface Props {
  title: string;
  description: string;
  client?: string;
  tags: string[];
  tech: string[];
  image?: string;
  liveUrl?: string;
  caseStudyUrl?: string;
  startDate: Date;
  endDate?: Date;
}

const {
  title,
  description,
  client,
  tags,
  tech,
  image,
  liveUrl,
  caseStudyUrl,
  startDate,
  endDate,
} = Astro.props;
---

<BaseLayout title={title} description={description} image={image}>
  <article class="container">
    <header class="work-header">
      {image && (
        <div class="work-image">
          <img src={image} alt={title} />
        </div>
      )}
      <h1>{title}</h1>
      {client && <p class="work-client">{client}</p>}

      <p class="work-date">
        <FormattedDate date={startDate} />
        {endDate ? (
          <>
            {' '}&mdash; <FormattedDate date={endDate} />
          </>
        ) : (
          <> &mdash; Present</>
        )}
      </p>

      <p class="work-description">{description}</p>

      <div class="work-meta">
        <div class="meta-section">
          <h3>Tags</h3>
          <TagList tags={tags} />
        </div>
        <div class="meta-section">
          <h3>Tech Stack</h3>
          <TagList tags={tech} />
        </div>
      </div>

      <div class="work-links">
        {liveUrl && (
          <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="work-link">
            View Live &rarr;
          </a>
        )}
        {caseStudyUrl && (
          <a href={caseStudyUrl} target="_blank" rel="noopener noreferrer" class="work-link">
            Case Study &rarr;
          </a>
        )}
      </div>
    </header>

    <div class="work-content content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .work-header {
    padding: var(--spacing-xl) 0;
    border-bottom: var(--border-width) solid var(--color-border);
    margin-bottom: var(--spacing-xl);
  }

  .work-image {
    margin-bottom: var(--spacing-lg);
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .work-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .work-header h1 {
    font-size: var(--font-size-4xl);
    margin-bottom: var(--spacing-sm);
  }

  .work-client {
    font-size: var(--font-size-xl);
    color: var(--color-accent);
    font-weight: 600;
    margin-bottom: var(--spacing-sm);
  }

  .work-date {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-lg);
  }

  .work-description {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-lg);
  }

  .work-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
  }

  .meta-section h3 {
    font-size: var(--font-size-base);
    margin-bottom: var(--spacing-sm);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .work-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
  }

  .work-link {
    padding: var(--spacing-sm) var(--spacing-lg);
    background-color: var(--color-accent);
    color: var(--background);
    border-radius: var(--border-radius);
    font-weight: 600;
    transition: background-color var(--transition-fast);
  }

  .work-link:hover {
    background-color: var(--pink);
    color: var(--background);
  }

  .work-content {
    margin: 0 auto;
    margin-bottom: var(--spacing-xl);
  }

  .work-content :global(h2) {
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
  }

  .work-content :global(h3) {
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-md);
  }

  .work-content :global(img) {
    margin: var(--spacing-lg) 0;
    border-radius: var(--border-radius);
  }

  @media (max-width: 640px) {
    .work-header h1 {
      font-size: var(--font-size-3xl);
    }

    .work-meta {
      grid-template-columns: 1fr;
    }
  }
</style>
