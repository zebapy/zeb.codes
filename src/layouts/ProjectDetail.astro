---
import BaseLayout from '@/components/BaseLayout.astro';
import TagList from '@/components/TagList.astro';

interface Props {
  title: string;
  description: string;
  tags: string[];
  tech: string[];
  image?: string;
  liveUrl?: string;
  githubUrl?: string;
  npmUrl?: string;
}

const { title, description, tags, tech, image, liveUrl, githubUrl, npmUrl } = Astro.props;
---

<BaseLayout title={title} description={description} image={image}>
  <article class="container">
    <header class="content mx-auto pb-12 pt-16">
      <a
        href="/projects"
        class="link-underline mb-8 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-comment hover:text-purple"
      >
        &larr; Projects
      </a>
      <h1 class="mb-6 tracking-tighter">{title}</h1>
      <p class="mb-8 text-lg leading-relaxed text-comment">{description}</p>

      <div class="grid gap-8 sm:grid-cols-2">
        {tags.length > 0 && (
          <div>
            <p class="kicker mb-3">Tags</p>
            <TagList tags={tags} />
          </div>
        )}
        {tech.length > 0 && (
          <div>
            <p class="kicker mb-3">Tech</p>
            <TagList tags={tech} />
          </div>
        )}
      </div>

      {(liveUrl || githubUrl || npmUrl) && (
        <div class="mt-8 flex flex-wrap gap-6">
          {liveUrl && (
            <a
              href={liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="link-underline font-mono text-xs uppercase tracking-widest"
            >
              Live
            </a>
          )}
          {githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="link-underline font-mono text-xs uppercase tracking-widest"
            >
              GitHub
            </a>
          )}
          {npmUrl && (
            <a
              href={npmUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="link-underline font-mono text-xs uppercase tracking-widest"
            >
              npm
            </a>
          )}
        </div>
      )}
    </header>

    {image && (
      <div class="content mx-auto mb-12 overflow-hidden border border-current-line/50">
        <img src={image} alt="" class="block h-auto w-full" />
      </div>
    )}

    <div class="prose content mx-auto mb-16">
      <slot />
    </div>
  </article>
</BaseLayout>
